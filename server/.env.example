# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/quiz?schema=public"

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"

# Allowed frontend origin(s) for CORS and Socket.IO.
# Must include the scheme. Accepts a comma-separated list for multiple deployments.
FRONTEND_URL="https://your-app.vercel.app,http://localhost:5173"

# Server port
PORT=5001

# Bootstrap SuperAdmin account (created automatically on first start)
SUPERADMIN_EMAIL="admin@admin.com"
SUPERADMIN_PASSWORD="admin@quizpulse"

# Optional. Without this the API runs on a single instance (in-memory sockets + queue).
# REDIS_URL="redis://localhost:6379"

# Optional. Without this, invite/reset emails are printed to the server logs.
# RESEND_API_KEY=""
# MAIL_FROM="QuizPulse <noreply@yourdomain.com>"

# --- Billing -----------------------------------------------------------
# Razorpay is the primary rail. Without these, checkout returns 501 and a
# SuperAdmin has to assign plans by hand.
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET=""
# The secret you typed into Razorpay Dashboard -> Settings -> Webhooks.
# Without it, webhook deliveries are rejected and renewals go unrecorded.
# RAZORPAY_WEBHOOK_SECRET=""

# --- Who is selling ----------------------------------------------------
# These go on the face of every tax invoice. Rule 46 of the CGST Rules
# requires the supplier's name, address and GSTIN; without them the document
# is a payment record, not a tax invoice, and the buyer cannot claim input
# credit against it.
# SELLER_LEGAL_NAME="Your Company Private Limited"
# SELLER_GSTIN="27AAAAA0000A1Z5"
# SELLER_ADDRESS="Floor 2, Some Building, Pune, Maharashtra 411001"
# SELLER_EMAIL="billing@yourdomain.com"

# Where the business is registered, as a two-digit state code. Decides whether
# a sale is CGST+SGST (intra-state) or IGST (inter-state). 27 = Maharashtra.
# Must agree with the first two digits of SELLER_GSTIN.
# SELLER_STATE_CODE="27"

# Legacy Stripe path, retained so any existing subscription keeps working.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_PRO=""

# HOST_TOKEN_TTL="7d"
# PARTICIPANT_TOKEN_TTL="12h"
# MAX_PARTICIPANTS_PER_EVENT=1000
# ANSWER_GRACE_PERIOD_SECONDS=3

# --- Operations --------------------------------------------------------
# A Slack or Discord incoming webhook. Without it errors are logged and
# nobody is told, which during a live session means nobody finds out until a
# customer says so.
# ALERT_WEBHOOK_URL=""

# Where backup-db.sh writes dumps, and how long it keeps them.
# BACKUP_DIR="/var/backups/quizpulse"
# BACKUP_RETAIN_DAYS=14
