# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/quiz?schema=public"

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"

# Allowed frontend origin(s) for CORS and Socket.IO.
# Must include the scheme. Accepts a comma-separated list for multiple deployments.
FRONTEND_URL="https://your-app.vercel.app,http://localhost:5173"

# Server port
PORT=5001

# Bootstrap SuperAdmin account (created automatically on first start)
SUPERADMIN_EMAIL="admin@admin.com"
SUPERADMIN_PASSWORD="admin@quizpulse"

# Optional. Without this the API runs on a single instance (in-memory sockets + queue).
# REDIS_URL="redis://localhost:6379"

# Optional. Without this, invite/reset emails are printed to the server logs.
# RESEND_API_KEY=""
# MAIL_FROM="QuizPulse <noreply@yourdomain.com>"

# Optional Stripe billing. SuperAdmin can still assign plans without Stripe.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_PRO=""

# HOST_TOKEN_TTL="7d"
# PARTICIPANT_TOKEN_TTL="12h"
# MAX_PARTICIPANTS_PER_EVENT=1000
# ANSWER_GRACE_PERIOD_SECONDS=3
