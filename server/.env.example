# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/quiz?schema=public"

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"

# Allowed frontend origin(s) for CORS and Socket.IO.
# Must include the scheme. Accepts a comma-separated list for multiple deployments.
FRONTEND_URL="https://your-app.vercel.app,http://localhost:5173"

# Server port
PORT=5001

# Bootstrap SuperAdmin account (created automatically on first start)
SUPERADMIN_EMAIL="admin@admin.com"
SUPERADMIN_PASSWORD="admin@quizpulse"
