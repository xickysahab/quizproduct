generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  SUBADMIN
  TENANT
  STAFF
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum QuestionType {
  MCQ
  MULTI_SELECT
  OPEN_TEXT
  WORD_CLOUD
  RATING
}

/// Lifecycle of an audience-submitted question.
/// PENDING only occurs on events with moderation switched on.
enum AudienceQuestionStatus {
  PENDING
  APPROVED
  ANSWERED
  DISMISSED
}

model Organization {
  id                   String        @id @default(uuid())
  name                 String
  slug                 String        @unique
  plan                 Plan          @default(FREE)
  logoUrl              String?
  primaryColor         String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  users                User[]
  events               Event[]
  invites              Invite[]
  usageMeters          UsageMeter[]
  invoices             Invoice[]
  /// Buyer tax details, for GST invoicing.
  gstin                String?
  /// Two-digit Indian state code; decides CGST+SGST versus IGST.
  stateCode            String?
  billingName          String?
  billingAddress       String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model UsageMeter {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period             String
  eventsCreated      Int          @default(0)
  participantsJoined Int          @default(0)

  @@unique([organizationId, period])
  @@index([period])
}

model Invite {
  id             String        @id @default(uuid())
  email          String
  role           Role
  tokenHash      String        @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  parentUserId   String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([email])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Every webhook event we have already acted on.
/// Razorpay signs no timestamp, so this table is the replay defence: an event
/// id can be consumed exactly once, whatever a replayed request claims.
model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  /// The provider's own event id.
  externalId  String
  type        String
  processedAt DateTime @default(now())

  @@unique([provider, externalId])
  @@index([processedAt])
}

/// DPDP Act 2023 §6: consent must be free, specific, informed and unambiguous,
/// and each purpose consented to separately. One row per purpose per person —
/// not a single bundled checkbox.
model ConsentRecord {
  id            String    @id @default(uuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  participantId String?
  purpose       String
  granted       Boolean
  /// The wording shown at the time, so consent can be evidenced later.
  policyVersion String
  grantedAt     DateTime  @default(now())
  withdrawnAt   DateTime?

  @@index([userId, purpose])
  @@index([participantId])
}

/// A DPDP erasure request and its outcome. Kept after the purge as the audit
/// trail that the erasure happened — it holds no personal data itself.
model DataDeletionRequest {
  id          String    @id @default(uuid())
  userId      String?
  /// Retained as a hash so a request can be matched without storing the address.
  emailHash   String
  status      String    @default("PENDING")
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  /// Counts of what was purged, for the compliance record.
  summary     Json?

  @@index([emailHash])
  @@index([status])
}

/// GST-compliant tax invoice. Indian finance teams reject software they cannot
/// expense, so this is a hard requirement rather than a nicety.
model Invoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Sequential, per financial year, as required for a tax invoice.
  invoiceNumber  String       @unique
  /// All money is stored in paise to avoid floating-point drift.
  subtotalPaise  Int
  cgstPaise      Int          @default(0)
  sgstPaise      Int          @default(0)
  igstPaise      Int          @default(0)
  totalPaise     Int
  currency       String       @default("INR")
  gstin          String?
  /// Buyer's state code, which decides CGST+SGST versus IGST.
  placeOfSupply  String?
  hsnSac         String       @default("998434")
  status         String       @default("PAID")
  provider       String?
  providerRef    String?
  issuedAt       DateTime     @default(now())

  @@index([organizationId, issuedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  password         String
  name             String
  role             Role                 @default(STAFF)
  isActive         Boolean              @default(true)
  tokenVersion     Int                  @default(0)
  parentUserId     String?
  parentUser       User?                @relation("UserHierarchy", fields: [parentUserId], references: [id])
  subUsers         User[]               @relation("UserHierarchy")
  organizationId   String?
  organization     Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  /// Null until the address is confirmed. Self-serve accounts may sign in
  /// before verifying, but cannot run a live event until they have.
  emailVerifiedAt  DateTime?
  events           Event[]
  activityLogs     ActivityLog[]
  passwordResets   PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  consents         ConsentRecord[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([parentUserId])
  @@index([role])
  @@index([organizationId])
}

model Event {
  id                       String         @id @default(uuid())
  title                    String
  roomCode                 String         @unique
  hostId                   String
  host                     User           @relation(fields: [hostId], references: [id])
  organizationId           String?
  organization             Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  isLive                   Boolean        @default(false)
  isTemplate               Boolean        @default(false)
  currentQuestionId        String?
  /// Set when the host opens a question. Used to reject answers submitted after the time limit.
  currentQuestionStartedAt DateTime?
  concludeConfig           Json?
  /// Audience Q&A. On by default — it is the reason most people open the room.
  qaEnabled                Boolean        @default(true)
  /// When true, submitted questions stay PENDING until a host approves them.
  qaModerated              Boolean        @default(false)
  /// Participants may join without giving a name.
  allowAnonymous           Boolean        @default(true)
  /// Set when the room is closed to new joins, so a code stops working instead
  /// of every code ever issued staying live forever.
  roomCodeRetiredAt        DateTime?
  questions                Question[]
  participants             Participant[]
  audienceQuestions        AudienceQuestion[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([hostId, createdAt])
  @@index([organizationId])
}

model Question {
  id             String       @id @default(uuid())
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type           QuestionType @default(MCQ)
  text           String
  options        String[]
  correctOption  Int?
  correctOptions Int[]        @default([])
  order          Int
  timeLimit      Int?
  responses      Response[]

  @@index([eventId, order])
}

model Participant {
  id        String     @id @default(uuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Empty for an anonymous participant; the UI shows a generated label.
  name      String
  /// Stable per-device key so a refresh or a re-join reuses this row instead of
  /// creating a duplicate that splits the person's score and double-counts them
  /// against the plan's participant cap.
  sessionKey String?
  socketId  String?
  responses Response[]
  audienceQuestions AudienceQuestion[]
  audienceVotes     AudienceQuestionVote[]
  joinedAt  DateTime   @default(now())

  @@unique([eventId, sessionKey])
  @@index([eventId])
}

/// A question asked by the audience, not by the host.
model AudienceQuestion {
  id            String                 @id @default(uuid())
  eventId       String
  event         Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Null once the participant is removed; the question itself survives.
  participantId String?
  participant   Participant?           @relation(fields: [participantId], references: [id], onDelete: SetNull)
  /// Null means the author chose to stay anonymous.
  authorName    String?
  text          String
  status        AudienceQuestionStatus @default(APPROVED)
  /// Denormalised from votes so the list can be sorted without a join.
  upvoteCount   Int                    @default(0)
  answeredAt    DateTime?
  createdAt     DateTime               @default(now())
  votes         AudienceQuestionVote[]

  @@index([eventId, status, upvoteCount])
  @@index([eventId, createdAt])
}

model AudienceQuestionVote {
  id                 String           @id @default(uuid())
  audienceQuestionId String
  audienceQuestion   AudienceQuestion @relation(fields: [audienceQuestionId], references: [id], onDelete: Cascade)
  participantId      String
  participant        Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  /// One vote per person per question, enforced by the database rather than
  /// by application logic that a retry could slip past.
  @@unique([audienceQuestionId, participantId])
  @@index([participantId])
}

model Response {
  id              String      @id @default(uuid())
  questionId      String
  question        Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participantId   String
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  selectedOption  Int         @default(0)
  selectedOptions Int[]       @default([])
  answerText      String?
  score           Int         @default(0)
  isCorrect       Boolean     @default(false)
  respondedAt     DateTime    @default(now())

  @@unique([questionId, participantId])
  @@index([participantId])
  /// A covering index on (participantId) INCLUDE (score, isCorrect, respondedAt)
  /// also exists — see migration 20260823220000_leaderboard_covering_index.
  /// Prisma cannot express INCLUDE columns, so it lives in raw SQL.
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  resource   String
  resourceId String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
