generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  SUBADMIN
  TENANT
  STAFF
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

/// Where a workspace sits in the paid lifecycle.
///
/// `plan` alone cannot express this. A workspace whose PRO month has run out
/// still has `plan = PRO` on the row until a sweep rewrites it, and a paying
/// customer three days past due should not be cut off mid-event. The status
/// and `planExpiresAt` together decide what the workspace can actually do —
/// see utils/subscription.ts, which is the only place that decision is made.
enum SubscriptionStatus {
  /// Never paid. On the free tier by default, not by expiry.
  NONE
  /// Paid and inside the period.
  ACTIVE
  /// Past `planExpiresAt` but inside the grace window. Still full access,
  /// because cutting someone off during a live session loses the customer
  /// more surely than a few unpaid days costs.
  GRACE
  /// Past grace. Limits are the free tier's until they pay again.
  EXPIRED
  /// Assigned by a SuperAdmin rather than bought, so it does not expire.
  /// Enterprise contracts and comped accounts live here.
  MANUAL
}

enum QuestionType {
  MCQ
  MULTI_SELECT
  OPEN_TEXT
  WORD_CLOUD
  RATING
  /// Participants order the options; results are a mean rank.
  RANKING
}

/// Lifecycle of an audience-submitted question.
/// PENDING only occurs on events with moderation switched on.
enum AudienceQuestionStatus {
  PENDING
  APPROVED
  ANSWERED
  DISMISSED
}

/// QUIZ grades answers and can show correct/incorrect.
/// SURVEY collects opinions only — no scoring, no answer-key reveal.
/// Legacy grading signal, now DERIVED from `scoringEnabled` and kept in sync on
/// every write. It is read in ~80 places across both apps; renaming it would be
/// a large, risky refactor for no behavioural gain, and it already means exactly
/// "is this session graded?". Treat `scoringEnabled` as authoritative and never
/// set this by hand.
enum SessionMode {
  QUIZ
  SURVEY
}

/// A named bundle of switches, not a behaviour of its own.
/// Applying a preset writes the switches below; changing any switch afterwards
/// moves the session to CUSTOM. This is what makes mixing possible — a mode
/// enum alone could never express "Q&A on, scored on, podium off".
enum SessionPreset {
  /// Q&A led, unscored, anonymous. Meetings and town halls.
  DISCUSSION
  /// Scored race with speed, streak, scoreboard and podium.
  GAME
  /// Opinion collection. Never graded, results kept from the audience.
  SURVEY
  /// Any combination the host has assembled themselves.
  CUSTOM
}

enum LeaderboardVisibility {
  HIDDEN
  HOST_ONLY
  EVERYONE
}

enum ResultsReveal {
  /// The host presses a button. Nothing is shown until they do.
  HOST_TRIGGERED
  /// Shown automatically once the question closes.
  AUTO_AFTER_QUESTION
  /// The audience never sees the distribution.
  NEVER
}

/// Per-question override of the session's scoring switch — the mechanism that
/// lets one session hold unscored opinion polls and scored quiz questions.
enum ScoredOverride {
  INHERIT
  YES
  NO
}

model Organization {
  id                   String        @id @default(uuid())
  name                 String
  slug                 String        @unique
  plan                 Plan          @default(FREE)
  logoUrl              String?
  primaryColor         String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  /// ---- Subscription lifecycle -------------------------------------------
  /// `plan` is what was bought; these say whether it is still owed.
  planStatus             SubscriptionStatus @default(NONE)
  planStartedAt          DateTime?
  /// Null means the plan does not expire — the free tier, or a MANUAL grant.
  planExpiresAt          DateTime?
  planCancelledAt        DateTime?
  users                User[]
  events               Event[]
  invites              Invite[]
  usageMeters          UsageMeter[]
  invoices             Invoice[]
  /// Buyer tax details, for GST invoicing.
  gstin                String?
  /// Two-digit Indian state code; decides CGST+SGST versus IGST.
  stateCode            String?
  /// ISO-3166 alpha-2. "IN" means Indian GST applies and a state code is
  /// required; anything else is an export of services and zero-rated. Without
  /// this the two cases are indistinguishable, and a missing state code was
  /// silently read as "not in India" — charging an Indian buyer no GST at all
  /// while we still owed the 18%.
  billingCountry       String        @default("IN")
  billingName          String?
  billingAddress       String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  /// The expiry sweep scans by these two and nothing else.
  @@index([planStatus, planExpiresAt])
}

model UsageMeter {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period             String
  eventsCreated      Int          @default(0)
  participantsJoined Int          @default(0)

  @@unique([organizationId, period])
  @@index([period])
}

model Invite {
  id             String        @id @default(uuid())
  email          String
  role           Role
  tokenHash      String        @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  parentUserId   String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([email])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Every webhook event we have already acted on.
/// Razorpay signs no timestamp, so this table is the replay defence: an event
/// id can be consumed exactly once, whatever a replayed request claims.
model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  /// The provider's own event id.
  externalId  String
  type        String
  processedAt DateTime @default(now())

  @@unique([provider, externalId])
  @@index([processedAt])
}

/// DPDP Act 2023 §6: consent must be free, specific, informed and unambiguous,
/// and each purpose consented to separately. One row per purpose per person —
/// not a single bundled checkbox.
model ConsentRecord {
  id            String    @id @default(uuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  participantId String?
  purpose       String
  granted       Boolean
  /// The wording shown at the time, so consent can be evidenced later.
  policyVersion String
  grantedAt     DateTime  @default(now())
  withdrawnAt   DateTime?

  @@index([userId, purpose])
  @@index([participantId])
}

/// A DPDP erasure request and its outcome. Kept after the purge as the audit
/// trail that the erasure happened — it holds no personal data itself.
model DataDeletionRequest {
  id          String    @id @default(uuid())
  userId      String?
  /// Retained as a hash so a request can be matched without storing the address.
  emailHash   String
  status      String    @default("PENDING")
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  /// Counts of what was purged, for the compliance record.
  summary     Json?

  @@index([emailHash])
  @@index([status])
}

/// GST-compliant tax invoice. Indian finance teams reject software they cannot
/// expense, so this is a hard requirement rather than a nicety.
model Invoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Sequential, per financial year, as required for a tax invoice.
  invoiceNumber  String       @unique
  /// All money is stored in paise to avoid floating-point drift.
  subtotalPaise  Int
  cgstPaise      Int          @default(0)
  sgstPaise      Int          @default(0)
  igstPaise      Int          @default(0)
  totalPaise     Int
  currency       String       @default("INR")
  gstin          String?
  /// Buyer's state code, which decides CGST+SGST versus IGST.
  placeOfSupply  String?
  hsnSac         String       @default("998434")
  /// TAX_INVOICE when the supplier is GST-registered, BILL_OF_SUPPLY when not.
  /// Recorded per document rather than derived from config, because config
  /// changes the day registration comes through and must not retroactively
  /// relabel documents already issued and filed.
  documentType   String       @default("TAX_INVOICE")
  status         String       @default("PAID")
  provider       String?
  providerRef    String?
  /// What was actually bought. Without this an invoice cannot be read back
  /// years later, which is exactly what a tax invoice is for.
  plan           Plan?
  periodStart    DateTime?
  periodEnd      DateTime?
  issuedAt       DateTime     @default(now())

  @@index([organizationId, issuedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  password         String
  name             String
  role             Role                 @default(STAFF)
  isActive         Boolean              @default(true)
  tokenVersion     Int                  @default(0)
  parentUserId     String?
  parentUser       User?                @relation("UserHierarchy", fields: [parentUserId], references: [id])
  subUsers         User[]               @relation("UserHierarchy")
  organizationId   String?
  organization     Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  /// Null until the address is confirmed. Self-serve accounts may sign in
  /// before verifying, but cannot run a live event until they have.
  emailVerifiedAt  DateTime?
  events           Event[]
  activityLogs     ActivityLog[]
  passwordResets   PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  consents         ConsentRecord[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([parentUserId])
  @@index([role])
  @@index([organizationId])
}

model Event {
  id                       String         @id @default(uuid())
  title                    String
  roomCode                 String         @unique
  hostId                   String
  host                     User           @relation(fields: [hostId], references: [id])
  organizationId           String?
  organization             Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  isLive                   Boolean        @default(false)
  isTemplate               Boolean        @default(false)
  /// When on, correct answers score more when submitted earlier in the timer.
  /// Ignored when sessionMode is SURVEY.
  /// ---- Session personality ----------------------------------------------
  /// `preset` is a label recording which bundle was applied; the switches below
  /// are what the server actually reads.
  preset                   SessionPreset  @default(GAME)
  /// Authoritative. `sessionMode` is derived from this.
  scoringEnabled           Boolean        @default(true)
  speedBonusEnabled        Boolean        @default(false)
  streakBonusEnabled       Boolean        @default(false)
  leaderboardVisibility    LeaderboardVisibility @default(EVERYONE)
  /// The full-screen standings moment between questions.
  scoreboardBetweenQuestions Boolean      @default(false)
  podiumAtEnd              Boolean        @default(true)
  resultsReveal            ResultsReveal  @default(HOST_TRIGGERED)
  /// Advance automatically when the timer runs out.
  autoAdvance              Boolean        @default(false)
  /// When false, phones show only the answer tiles so eyes go to the big screen.
  phoneShowsQuestion       Boolean        @default(true)
  soundEnabled             Boolean        @default(false)
  /// QUIZ = scored with optional answer keys. SURVEY = opinion / feedback only.
  sessionMode              SessionMode    @default(QUIZ)
  currentQuestionId        String?
  /// Set when the host opens a question. Used to reject answers submitted after the time limit.
  currentQuestionStartedAt DateTime?
  concludeConfig           Json?
  /// Audience Q&A. On by default — it is the reason most people open the room.
  qaEnabled                Boolean        @default(true)
  /// When true, submitted questions stay PENDING until a host approves them.
  qaModerated              Boolean        @default(false)
  /// Participants may join without giving a name.
  allowAnonymous           Boolean        @default(true)
  /// Set when the room is closed to new joins, so a code stops working instead
  /// of every code ever issued staying live forever.
  roomCodeRetiredAt        DateTime?
  /// Argon-free: a short passcode hashed with SHA-256. Not a password — it is a
  /// low-entropy door code shared with a room, so it is stored hashed to avoid
  /// leaking it from a database dump, not to resist offline cracking.
  passcodeHash             String?
  questions                Question[]
  participants             Participant[]
  audienceQuestions        AudienceQuestion[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([hostId, createdAt])
  @@index([organizationId])
}

model Question {
  id             String       @id @default(uuid())
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type           QuestionType @default(MCQ)
  text           String
  options        String[]
  correctOption  Int?
  correctOptions Int[]        @default([])
  order          Int
  timeLimit      Int?
  /// Overrides the session's scoring switch for this question only.
  scored         ScoredOverride @default(INHERIT)
  responses      Response[]

  @@index([eventId, order])
}

model Participant {
  id        String     @id @default(uuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Empty for an anonymous participant; the UI shows a generated label.
  name      String
  /// Stable per-device key so a refresh or a re-join reuses this row instead of
  /// creating a duplicate that splits the person's score and double-counts them
  /// against the plan's participant cap.
  sessionKey String?
  socketId  String?
  responses Response[]
  audienceQuestions AudienceQuestion[]
  audienceVotes     AudienceQuestionVote[]
  joinedAt  DateTime   @default(now())

  @@unique([eventId, sessionKey])
  @@index([eventId])
}

/// A question asked by the audience, not by the host.
model AudienceQuestion {
  id            String                 @id @default(uuid())
  eventId       String
  event         Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Null once the participant is removed; the question itself survives.
  participantId String?
  participant   Participant?           @relation(fields: [participantId], references: [id], onDelete: SetNull)
  /// Null means the author chose to stay anonymous.
  authorName    String?
  text          String
  status        AudienceQuestionStatus @default(APPROVED)
  /// Denormalised from votes so the list can be sorted without a join.
  upvoteCount   Int                    @default(0)
  answeredAt    DateTime?
  createdAt     DateTime               @default(now())
  votes         AudienceQuestionVote[]

  @@index([eventId, status, upvoteCount])
  @@index([eventId, createdAt])
}

model AudienceQuestionVote {
  id                 String           @id @default(uuid())
  audienceQuestionId String
  audienceQuestion   AudienceQuestion @relation(fields: [audienceQuestionId], references: [id], onDelete: Cascade)
  participantId      String
  participant        Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  /// One vote per person per question, enforced by the database rather than
  /// by application logic that a retry could slip past.
  @@unique([audienceQuestionId, participantId])
  @@index([participantId])
}

model Response {
  id              String      @id @default(uuid())
  questionId      String
  question        Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participantId   String
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  selectedOption  Int         @default(0)
  selectedOptions Int[]       @default([])
  answerText      String?
  /// For RANKING: the option indices in the order the participant placed them.
  rankedOptions   Int[]       @default([])
  /// Consecutive correct answers up to and including this one, at answer time.
  /// Stored rather than derived so a later edit to an earlier answer cannot
  /// retroactively rewrite a score that was already shown to somebody.
  streak          Int         @default(0)
  score           Int         @default(0)
  isCorrect       Boolean     @default(false)
  respondedAt     DateTime    @default(now())

  @@unique([questionId, participantId])
  @@index([participantId])
  /// A covering index on (participantId) INCLUDE (score, isCorrect, respondedAt)
  /// also exists — see migration 20260823220000_leaderboard_covering_index.
  /// Prisma cannot express INCLUDE columns, so it lives in raw SQL.
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  resource   String
  resourceId String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
